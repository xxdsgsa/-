# 复制为 .env 并填入真实值;.env 已被 .gitignore 排除,严禁提交

# 数据库(Neon PostgreSQL 连接串)
DATABASE_URL=

# Better Auth(会话与密码);SECRET 用 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend(注册/找回/注销验证码邮件)
RESEND_API_KEY=
EMAIL_FROM="FitMate <onboarding@resend.dev>"

# Sentry(仅生产,上线前接入)
SENTRY_DSN=
